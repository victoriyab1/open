# Никогда не публикуйте .env. Значения вводятся в Environment на Render.
BOT_TOKEN=
# Ваш числовой Telegram ID. Пустое значение запрещает запуск.
OWNER_TELEGRAM_ID=
# Обязательно для Render: PostgreSQL connection string из Neon с sslmode=require.
# Для локальной проверки допустимо sqlite:///bot.sqlite3.
DATABASE_URL=sqlite:///bot.sqlite3
# Два РАЗНЫХ случайных секрета, минимум 32 символа каждый.
WEBHOOK_SECRET=
CRON_SECRET=
PUBLIC_URL=
DEFAULT_TIMEZONE=Europe/Moscow
